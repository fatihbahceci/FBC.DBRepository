<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet metadata -->
		<PackageId>FBC.DBRepository</PackageId>
		<Version>0.5.0</Version>
		<Authors>Fatih Bahceci</Authors>
		<Product>FBC.DBRepository</Product>
		<Description>A lightweight, generic, async-first repository pattern implementation for Entity Framework Core. Provides soft delete, audit tracking, pagination, role-based access control, transactions, and automatic DI registration.</Description>
		<PackageTags>efcore;repository;pattern;generic;async;softdelete;pagination;entityframework;rbac;transactions</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>0.5.0 — RestoreAsync now checks the roles required for Delete, and can validate on request. Automatic registration refuses ambiguity instead of choosing at random, skips open generics, and survives an assembly that fails to load. New: GetActiveQueryable(), EntityValidationException, cancellation tokens on the write path, RegisterRepositories(includeConcreteTypes: true). No source changes are needed to upgrade. Full notes: https://github.com/fatihbahceci/FBC.DBRepository/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/fatihbahceci/FBC.DBRepository</RepositoryUrl>
		<PackageProjectUrl>https://github.com/fatihbahceci/FBC.DBRepository</PackageProjectUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<ItemGroup>
		<!-- This project sits at the repository root, so the SDK's default glob would compile the test
		     project's sources into the library as well. -->
		<Compile Remove="tests/**" />
		<None Remove="tests/**" />
		<EmbeddedResource Remove="tests/**" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md">
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
	</ItemGroup>
</Project>
